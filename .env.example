# Everything here is OPTIONAL. Froola runs with no env file at all: clone,
# npm install, npm run dev, and the whole instrument works, storing recordings
# and lesson progress in the browser.
#
# Set these only if you want accounts, so a player's recordings and lesson
# progress follow them across devices. Values come from your own Supabase
# project, Settings → API. See README.md for the five-minute setup.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
